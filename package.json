{
  "name": "motion-render-plugin",
  "version": "0.4.0",
  "private": true,
  "description": "Claude Code plugin root for motion-render. Claude Code installs these dependencies when it installs the plugin; bin/motion-render runs the CLI in skills/motion-render.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "ffmpeg-static": "5.2.0",
    "playwright-core": "1.56.1"
  },
  "scripts": {
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "fmt-check": "prettier --check .",
    "typecheck": "tsc",
    "quality:check": "node scripts/quality-gate.mjs",
    "quality:check:ts": "node scripts/quality-gate.mjs --scope ts",
    "quality:update-baseline": "node scripts/quality-gate.mjs --update-baseline",
    "quality:test": "node --test scripts/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/node": "22.20.5",
    "eslint": "9.35.0",
    "globals": "16.3.0",
    "knip": "6.35.1",
    "prettier": "3.9.6",
    "typescript": "5.8.3",
    "typescript-eslint": "8.42.0"
  }
}
